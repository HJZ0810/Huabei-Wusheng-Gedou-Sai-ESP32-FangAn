# 示例值不包含可用于真实车辆的凭据；生产配置文件请放在工程目录之外。
COMBATBOT_CONFIG=/etc/combatbot/config.private.json
COMBATBOT_BASE_PATH=
COMBATBOT_PUBLIC_ORIGIN=https://combatbot.luo-jin-ai.com
COMBATBOT_HOST=127.0.0.1
COMBATBOT_PORT=8090
# 若由反向代理终止 TLS，Node 只监听回环地址；不设置这两项。
# COMBATBOT_TLS_CERT=/etc/combatbot/tls/server.crt
# COMBATBOT_TLS_KEY=/etc/combatbot/tls/server.key
